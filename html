                    <i class="fa-solid fa-download"></i>
                    <span>Baixar Minha Foto</span>
                </a>

                <button onclick="restartGame()" 
                        class="btn-accessible w-full py-3 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-lg flex items-center justify-center gap-2 border-b-4 border-blue-800">
                    <i class="fa-solid fa-rotate-right"></i>
