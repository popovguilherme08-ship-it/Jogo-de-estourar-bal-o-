                <button onclick="showCredits()" 
                        class="btn-accessible w-full py-3.5 px-6 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-lg md:text-xl font-bold flex items-center justify-center gap-2 border-b-4 border-slate-950">
