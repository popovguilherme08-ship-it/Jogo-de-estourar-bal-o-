            <!-- Lista de Criadores -->
            <div class="mb-6">
                <h3 class="text-lg font-bold text-blue-300 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-code text-pink-400"></i> Desenvolvedores do Projeto:
