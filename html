                        <i class="fa-solid fa-user-astronaut text-cyan-400 text-xl"></i>
                        <span class="font-bold text-slate-100 text-base md:text-lg">Angelo</span>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700 flex items-center gap-3">
                        <i class="fa-solid fa-user-astronaut text-pink-400 text-xl"></i>
                        <span class="font-bold text-slate-100 text-base md:text-lg">Carol</span>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700 flex items-center gap-3">
                        <i class="fa-solid fa-user-astronaut text-purple-400 text-xl"></i>
                        <span class="font-bold text-slate-100 text-base md:text-lg">Camila</span>
                    </div>
                    <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700 flex items-center gap-3">
