        </div>

        <div></div> <!-- Spacer bottom -->
    </div>

    <!-- SCRIPT DO JOGO -->
    <script>
        /* ==========================================================================
           1. CONFIGURAÇÕES, PALETA DE CORES E FRASES POSITIVAS
           ========================================================================== */
        const COLOR_PALETTE = [
            { name: 'Vermelho', hex: '#ef4444', border: '#b91c1c', highlight: '#fca5a5' },
            { name: 'Azul',     hex: '#3b82f6', border: '#1d4ed8', highlight: '#93c5fd' },
            { name: 'Amarelo',  hex: '#eab308', border: '#a16207', highlight: '#fde047' },
            { name: 'Verde',    hex: '#22c55e', border: '#15803d', highlight: '#86efac' },
            { name: 'Roxo',     hex: '#a855f7', border: '#7e22ce', highlight: '#d8b4fe' },
            { name: 'Rosa',     hex: '#ec4899', border: '#be185d', highlight: '#f472b6' },
            { name: 'Laranja',  hex: '#f97316', border: '#c2410c', highlight: '#fdba74' }
        ];

        const PRAISE_MESSAGES = [
            "Fantástico!", "Muito bem!", "Parabéns!", "Incrível!", "Show!", "Excelente!", "Mandou bem!", "Nota 10!"
        ];

        const DIFFICULTY_SETTINGS = {
            easy:   { speedMin: 1.0, speedMax: 1.8, target: 10, label: 'Fácil' },
            medium: { speedMin: 2.0, speedMax: 3.2, target: 15, label: 'Médio' },
            hard:   { speedMin: 3.5, speedMax: 5.0, target: 25, label: 'Difícil' }
        };

        let gameState = {
            mode: 'free',            // 'free' ou 'color'
            difficulty: 'easy',      // 'easy', 'medium', 'hard'
            score: 0,
            targetScore: 10,
            currentColorTarget: null,
            isPlaying: false,
            cameraStream: null
        };

        /* ==========================================================================
           2. SÍNTESE DE ÁUDIO & VOZ (Web Audio API & Speech Synthesis)
           ========================================================================== */
        class AudioController {
            constructor() {
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) this.ctx = new AudioContext();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playPop() {
                this.init();
                if (!this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    const now = this.ctx.currentTime;

                    osc.type = 'sine';
                    const freq = 350 + Math.random() * 250;
                    osc.frequency.setValueAtTime(freq, now);
                    osc.frequency.exponentialRampToValueAtTime(100, now + 0.08);

                    gain.gain.setValueAtTime(0.35, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now);
                    osc.stop(now + 0.09);
                } catch(e) {}
            }

            playVictoryMelody() {
                this.init();
                if (!this.ctx) return;

                const melody = [
                    { note: 523.25, duration: 0.15 }, // C5
                    { note: 659.25, duration: 0.15 }, // E5
                    { note: 783.99, duration: 0.15 }, // G5
                    { note: 1046.50, duration: 0.4 }  // C6
                ];

                let now = this.ctx.currentTime;
                melody.forEach((item) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(item.note, now);

                    gain.gain.setValueAtTime(0.25, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + item.duration);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now);
                    osc.stop(now + item.duration);

                    now += item.duration + 0.05;
                });
            }
        }

        const audioCtrl = new AudioController();

        function speakCurrentColor() {
            if (!gameState.currentColorTarget || !('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const text = `Estoure o balão ${gameState.currentColorTarget.name}!`;
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'pt-BR';
            utterance.rate = 0.9;
            utterance.pitch = 1.1;
            window.speechSynthesis.speak(utterance);
        }

        /* ==========================================================================
           3. CANVAS DO CÉU (CÉU AZUL, NUVENS, ESTRELAS, AVIÕES, HELICÓPTEROS)
           ========================================================================== */
        const skyCanvas = document.getElementById('skyCanvas');
        const skyCtx = skyCanvas.getContext('2d');
        let stars = [];
        let shootingStars = [];
        let clouds = [];
        let aircrafts = [];

        function resizeSkyCanvas() {
            skyCanvas.width = window.innerWidth;
            skyCanvas.height = window.innerHeight;
            initBackgroundElements();
        }

        function initBackgroundElements() {
            stars = [];
            clouds = [];
            aircrafts = [];

            // Estrelas discretas no fundo azul escuro
            for (let i = 0; i < 40; i++) {
                stars.push({
                    x: Math.random() * skyCanvas.width,
                    y: Math.random() * (skyCanvas.height * 0.6),
                    radius: Math.random() * 1.5 + 0.5,
                    alpha: Math.random(),
                    speed: Math.random() * 0.02 + 0.005
                });
            }

            // Nuvens fofas e suaves passando no fundo
            for (let i = 0; i < 5; i++) {
                clouds.push({
                    x: Math.random() * skyCanvas.width,
                    y: Math.random() * (skyCanvas.height * 0.5) + 30,
                    width: Math.random() * 120 + 90,
                    speed: Math.random() * 0.3 + 0.1
                });
            }

            // Avião ou Helicóptero ocasionais
            aircrafts.push({
                type: 'airplane',
                x: -150,
                y: Math.random() * 200 + 40,
                speed: 1.2,
                scale: 0.8
            });
            aircrafts.push({
                type: 'helicopter',
                x: skyCanvas.width + 150,
                y: Math.random() * 250 + 80,
                speed: -0.9,
                scale: 0.7
            });
        }

        function addShootingStar() {
            if (shootingStars.length < 2 && Math.random() < 0.01) {
                shootingStars.push({
                    x: Math.random() * skyCanvas.width * 0.8,
                    y: Math.random() * (skyCanvas.height * 0.4),
                    length: Math.random() * 80 + 50,
                    speed: Math.random() * 8 + 6,
                    angle: Math.PI / 4,
                    alpha: 1
                });
            }
        }

        function renderSky() {
            skyCtx.clearRect(0, 0, skyCanvas.width, skyCanvas.height);

            // 1. Desenha estrelas discretas
            skyCtx.fillStyle = '#ffffff';
            stars.forEach(star => {
                star.alpha += star.speed;
                if (star.alpha > 1 || star.alpha < 0.2) star.speed = -star.speed;
                skyCtx.globalAlpha = Math.max(0.1, Math.min(1, star.alpha));
                skyCtx.beginPath();
                skyCtx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
                skyCtx.fill();
            });

            // 2. Estrelas cadentes
            addShootingStar();
            for (let i = shootingStars.length - 1; i >= 0; i--) {
                const s = shootingStars[i];
                skyCtx.globalAlpha = s.alpha;
                const endX = s.x - Math.cos(s.angle) * s.length;
                const endY = s.y - Math.sin(s.angle) * s.length;

                const grad = skyCtx.createLinearGradient(s.x, s.y, endX, endY);
                grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
                grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

                skyCtx.strokeStyle = grad;
                skyCtx.lineWidth = 2;
                skyCtx.beginPath();
                skyCtx.moveTo(s.x, s.y);
                skyCtx.lineTo(endX, endY);
                skyCtx.stroke();

                s.x += Math.cos(s.angle) * s.speed;
                s.y += Math.sin(s.angle) * s.speed;
                s.alpha -= 0.015;

                if (s.alpha <= 0 || s.x > skyCanvas.width || s.y > skyCanvas.height) {
                    shootingStars.splice(i, 1);
                }
            }

            // 3. Nuvens suaves no crepúsculo
            skyCtx.fillStyle = 'rgba(255, 255, 255, 0.18)';
            clouds.forEach(c => {
                c.x += c.speed;
                if (c.x > skyCanvas.width + c.width) {
                    c.x = -c.width;
                    c.y = Math.random() * (skyCanvas.height * 0.5) + 30;
                }
                skyCtx.beginPath();
                skyCtx.arc(c.x, c.y, c.width * 0.35, 0, Math.PI * 2);
                skyCtx.arc(c.x + c.width * 0.3, c.y - c.width * 0.15, c.width * 0.3, 0, Math.PI * 2);
                skyCtx.arc(c.x + c.width * 0.6, c.y, c.width * 0.32, 0, Math.PI * 2);
                skyCtx.fill();
            });

            // 4. Aviões e Helicópteros passando
            aircrafts.forEach(ac => {
                ac.x += ac.speed;
                if (ac.speed > 0 && ac.x > skyCanvas.width + 150) {
                    ac.x = -150;
                    ac.y = Math.random() * 200 + 40;
                } else if (ac.speed < 0 && ac.x < -150) {
                    ac.x = skyCanvas.width + 150;
                    ac.y = Math.random() * 250 + 80;
                }

                skyCtx.save();
                skyCtx.translate(ac.x, ac.y);
                if (ac.speed < 0) skyCtx.scale(-1, 1);
                skyCtx.fillStyle = 'rgba(255, 255, 255, 0.65)';
                skyCtx.font = '24px "Font Awesome 6 Free", sans-serif';
                skyCtx.font = '28px sans-serif';
                
                if (ac.type === 'airplane') {
                    skyCtx.fillText('✈️', 0, 0);
                } else {
                    skyCtx.fillText('🚁', 0, 0);
                }
                skyCtx.restore();
            });

            skyCtx.globalAlpha = 1;
            requestAnimationFrame(renderSky);
        }

        /* ==========================================================================
           4. CANVAS DO JOGO (BALÕES REALISTAS & PARTÍCULAS)
           ========================================================================== */
        const gameCanvas = document.getElementById('gameCanvas');
        const gameCtx = gameCanvas.getContext('2d');
        let balloons = [];
        let particles = [];
        let spawnTimer = 0;

        function resizeGameCanvas() {
            gameCanvas.width = window.innerWidth;
            gameCanvas.height = window.innerHeight;
        }

        // Classe do Balão Realista 3D
        class Balloon {
            constructor(colorObj, speed) {
                this.color = colorObj;
                this.radius = Math.random() * 12 + 42; // Balões grandes e fáceis de interagir
                this.x = Math.random() * (gameCanvas.width - this.radius * 2) + this.radius;
                this.y = gameCanvas.height + this.radius + 20;
                this.speed = speed;
                this.wobble = Math.random() * Math.PI * 2;
                this.wobbleSpeed = Math.random() * 0.03 + 0.01;
            }

            update() {
                this.y -= this.speed;
                this.wobble += this.wobbleSpeed;
                this.x += Math.sin(this.wobble) * 0.9;
            }

            draw() {
                gameCtx.save();
                gameCtx.translate(this.x, this.y);

                // Linha / Cordinha do Balão
                gameCtx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
                gameCtx.lineWidth = 2.5;
                gameCtx.beginPath();
                gameCtx.moveTo(0, this.radius);
                gameCtx.quadraticCurveTo(10, this.radius + 20, 0, this.radius + 40);
                gameCtx.stroke();

                // Corpo do Balão (Formato de Gota/Lágrima invertida realista)
                gameCtx.beginPath();
                gameCtx.ellipse(0, 0, this.radius * 0.82, this.radius, 0, 0, Math.PI * 2);
                
                // Gradiente 3D com alto brilho simulando borracha/látex lustroso
                const grad = gameCtx.createRadialGradient(
                    -this.radius * 0.35, -this.radius * 0.35, this.radius * 0.05,
                    0, 0, this.radius
                );
                grad.addColorStop(0, '#ffffff');
                grad.addColorStop(0.25, this.color.highlight);
                grad.addColorStop(0.65, this.color.hex);
                grad.addColorStop(1, this.color.border);

                gameCtx.fillStyle = grad;
                gameCtx.shadowColor = 'rgba(0, 0, 0, 0.3)';
                gameCtx.shadowBlur = 10;
                gameCtx.fill();
                gameCtx.shadowBlur = 0; // Limpa sombra para otimizar

                // Brilho oval especular (Glossy highlight)
                gameCtx.fillStyle = 'rgba(255, 255, 255, 0.6)';
                gameCtx.beginPath();
                gameCtx.ellipse(-this.radius * 0.3, -this.radius * 0.35, this.radius * 0.22, this.radius * 0.12, Math.PI / 4, 0, Math.PI * 2);
                gameCtx.fill();

                // Nó na base do balão
                gameCtx.fillStyle = this.color.border;
                gameCtx.beginPath();
                gameCtx.moveTo(-4, this.radius - 2);
                gameCtx.lineTo(4, this.radius - 2);
                gameCtx.lineTo(2, this.radius + 5);
                gameCtx.lineTo(-2, this.radius + 5);
                gameCtx.closePath();
                gameCtx.fill();

                gameCtx.restore();
            }

            containsPoint(px, py) {
                const dx = px - this.x;
                const dy = py - this.y;
                return (dx * dx) + (dy * dy) <= (this.radius * 1.25) * (this.radius * 1.25);
            }
        }

        // Partículas de Estouro Fluido
        class Particle {
            constructor(x, y, colorHex) {
                this.x = x;
                this.y = y;
                this.color = colorHex;
                this.radius = Math.random() * 6 + 3;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 7 + 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.decay = Math.random() * 0.03 + 0.02;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += 0.12; // Gravidade
                this.alpha -= this.decay;
            }

            draw() {
                gameCtx.save();
                gameCtx.globalAlpha = Math.max(0, this.alpha);
                gameCtx.fillStyle = this.color;
                gameCtx.beginPath();
                gameCtx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                gameCtx.fill();
                gameCtx.restore();
            }
        }

        function createPopParticles(x, y, colorHex) {
            for (let i = 0; i < 18; i++) {
                particles.push(new Particle(x, y, colorHex));
            }
        }

        function showFloatingPraise(x, y) {
            const container = document.getElementById('praiseContainer');
            const msg = PRAISE_MESSAGES[Math.floor(Math.random() * PRAISE_MESSAGES.length)];
            
            const el = document.createElement('div');
            el.className = 'floating-praise';
            el.textContent = msg;
            
            // Centraliza em torno do clique ou limita à tela
            const posX = Math.max(50, Math.min(window.innerWidth - 150, x - 50));
            const posY = Math.max(80, Math.min(window.innerHeight - 100, y - 40));
            
            el.style.left = `${posX}px`;
            el.style.top = `${posY}px`;
            
            container.appendChild(el);
            setTimeout(() => el.remove(), 900);
        }

        function gameLoop() {
            gameCtx.clearRect(0, 0, gameCanvas.width, gameCanvas.height);

            if (gameState.isPlaying) {
                spawnTimer++;
                if (spawnTimer % 38 === 0) {
                    const randomColor = COLOR_PALETTE[Math.floor(Math.random() * COLOR_PALETTE.length)];
                    const settings = DIFFICULTY_SETTINGS[gameState.difficulty];
                    const speed = Math.random() * (settings.speedMax - settings.speedMin) + settings.speedMin;
                    balloons.push(new Balloon(randomColor, speed));
                }

                for (let i = balloons.length - 1; i >= 0; i--) {
                    const b = balloons[i];
                    b.update();
                    b.draw();

                    if (b.y < -b.radius * 2) {
                        balloons.splice(i, 1);
                    }
                }
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.update();
                p.draw();
                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            requestAnimationFrame(gameLoop);
        }

        /* ==========================================================================
           5. INTERAÇÃO DE TOQUE / CLIQUE NOS BALÕES
           ========================================================================== */
        function handleInteraction(e) {
            if (!gameState.isPlaying) return;

            const rect = gameCanvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            const clickX = clientX - rect.left;
            const clickY = clientY - rect.top;

            for (let i = balloons.length - 1; i >= 0; i--) {
                const b = balloons[i];
                if (b.containsPoint(clickX, clickY)) {
                    audioCtrl.playPop();
                    createPopParticles(b.x, b.y, b.color.hex);
                    showFloatingPraise(clientX, clientY);

                    if (gameState.mode === 'color') {
                        if (b.color.name === gameState.currentColorTarget.name) {
                            addScore();
                            selectNewTargetColor();
                        }
                    } else {
                        addScore();
                    }

                    balloons.splice(i, 1);
                    break;
                }
            }
        }

        gameCanvas.addEventListener('mousedown', handleInteraction);
        gameCanvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            handleInteraction(e);
        }, { passive: false });

        /* ==========================================================================
           6. GERENCIAMENTO DE MODO, DIFICULDADE E LÓGICA DO JOGO
           ========================================================================== */
        let tempSelectedMode = 'free';

        function openDifficultyMenu(mode) {
            tempSelectedMode = mode;
            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('difficultyMenu').classList.remove('hidden');
            
            const titleEl = document.getElementById('difficultyModeTitle');
            titleEl.textContent = mode === 'color' ? 'Modo de Cores (Com Voz)' : 'Modo Livre';
        }

        function closeDifficultyMenu() {
            document.getElementById('difficultyMenu').classList.add('hidden');
            document.getElementById('mainMenu').classList.remove('hidden');
        }

        function selectDifficulty(diff) {
            gameState.mode = tempSelectedMode;
            gameState.difficulty = diff;
            gameState.score = 0;
            gameState.targetScore = DIFFICULTY_SETTINGS[diff].target;

            document.getElementById('difficultyMenu').classList.add('hidden');
            document.getElementById('gameHUD').classList.remove('hidden');

            const diffBadge = document.getElementById('difficultyBadge');
            diffBadge.textContent = `${gameState.mode === 'color' ? 'Cores' : 'Livre'} • ${DIFFICULTY_SETTINGS[diff].label}`;

            const btnVoice = document.getElementById('btnRepeatVoice');
            if (gameState.mode === 'color') {
                btnVoice.classList.remove('hidden');
                selectNewTargetColor();
            } else {
                btnVoice.classList.add('hidden');
                document.getElementById('targetColorText').textContent = 'Estoure os balões!';
            }

            updateScoreDisplay();
            balloons = [];
            particles = [];
            gameState.isPlaying = true;
        }

        function selectNewTargetColor() {
            const randomColor = COLOR_PALETTE[Math.floor(Math.random() * COLOR_PALETTE.length)];
            gameState.currentColorTarget = randomColor;
            
            const targetText = document.getElementById('targetColorText');
            targetText.textContent = `Estoure: ${randomColor.name}`;
            targetText.style.color = randomColor.highlight;

            speakCurrentColor();
        }

        function addScore() {
            gameState.score++;
            updateScoreDisplay();

            if (gameState.score >= gameState.targetScore) {
                triggerVictory();
            }
        }

        function updateScoreDisplay() {
            document.getElementById('scoreDisplay').textContent = `${gameState.score} / ${gameState.targetScore}`;
        }

        function returnToMenu() {
            gameState.isPlaying = false;
            stopWebcam();
            document.getElementById('gameHUD').classList.add('hidden');
            document.getElementById('victoryModal').classList.add('hidden');
            document.getElementById('mainMenu').classList.remove('hidden');
        }

        function showCredits() {
            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('creditsModal').classList.remove('hidden');
        }

        function closeCredits() {
            document.getElementById('creditsModal').classList.add('hidden');
            document.getElementById('mainMenu').classList.remove('hidden');
        }

        function restartGame() {
            document.getElementById('victoryModal').classList.add('hidden');
            selectDifficulty(gameState.difficulty);
        }

        /* ==========================================================================
           7. VITÓRIA, MÚSICA & INTEGRAÇÃO COM WEBCAM
           ========================================================================== */
        function triggerVictory() {
            gameState.isPlaying = false;
            audioCtrl.playVictoryMelody();

            document.getElementById('gameHUD').classList.add('hidden');
            document.getElementById('victoryModal').classList.remove('hidden');

            document.getElementById('photoPreview').classList.add('hidden');
            document.getElementById('webcamVideo').classList.remove('hidden');
            document.getElementById('btnDownloadPhoto').classList.add('hidden');
            document.getElementById('takePhotoText').textContent = 'Tirar Foto da Vitória!';

            startWebcam();
        }

        async function startWebcam() {
            const video = document.getElementById('webcamVideo');
            const errorMsg = document.getElementById('cameraErrorMsg');
            errorMsg.classList.add('hidden');

            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: "user" },
                    audio: false
                });
                gameState.cameraStream = stream;
                video.srcObject = stream;
            } catch (err) {
                console.warn("Câmera não acessível: ", err);
                errorMsg.classList.remove('hidden');
            }
        }

        function stopWebcam() {
            if (gameState.cameraStream) {
                gameState.cameraStream.getTracks().forEach(track => track.stop());
                gameState.cameraStream = null;
            }
        }

        function takeVictoryPhoto() {
            const video = document.getElementById('webcamVideo');
            const photoCanvas = document.getElementById('photoCanvas');
            const photoPreview = document.getElementById('photoPreview');
            const btnDownload = document.getElementById('btnDownloadPhoto');

            if (!gameState.cameraStream) return;

            photoCanvas.width = video.videoWidth || 640;
            photoCanvas.height = video.videoHeight || 480;
            const ctx = photoCanvas.getContext('2d');

            ctx.translate(photoCanvas.width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(video, 0, 0, photoCanvas.width, photoCanvas.height);

            ctx.scale(-1, 1);
            ctx.fillStyle = '#f59e0b';
            ctx.font = 'bold 24px Fredoka, sans-serif';
            ctx.fillText('CAMPEÃO SENAI ADS ⭐', -photoCanvas.width + 20, photoCanvas.height - 30);

            const dataUrl = photoCanvas.toDataURL('image/png');
            photoPreview.src = dataUrl;
            photoPreview.classList.remove('hidden');
            video.classList.add('hidden');

            btnDownload.href = dataUrl;
            btnDownload.classList.remove('hidden');
            document.getElementById('takePhotoText').textContent = 'Tirar Outra Foto';
        }

        /* ==========================================================================
           8. INICIALIZAÇÃO E RESIZE
           ========================================================================== */
        window.addEventListener('resize', () => {
            resizeSkyCanvas();
            resizeGameCanvas();
        });

        window.onload = () => {
            resizeSkyCanvas();
            resizeGameCanvas();
            renderSky();
            gameLoop();
        };
    </script>
</body>
</html>
