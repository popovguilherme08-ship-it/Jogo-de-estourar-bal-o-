<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Balões SENAI ADS - Jogo de Estourar Balões</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Fredoka & Quicksand -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Fredoka', 'Quicksand', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        /* Fundo Azul Sereno de Fim de Tarde / Crepúsculo */
        body {
            background: linear-gradient(to bottom, #04091f 0%, #0d1b3e 40%, #1a3668 75%, #2a4c8a 100%);
            overflow: hidden;
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
        }

        /* Canvas do Céu (Estrelas, Nuvens, Estrelas Cadentes, Aviões, Helicópteros) */
        #skyCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* Canvas de Jogo (Balões e Partículas) */
        #gameCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        /* Camada de Interface do Usuário (UI) */
        #uiLayer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 20;
            pointer-events: none;
        }

        .interactive {
            pointer-events: auto;
        }

        /* Botões Acessíveis Interativos */
        .btn-accessible {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.5), 0 0 0 4px rgba(255, 255, 255, 0.2);
        }
        .btn-accessible:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.6), 0 0 0 6px rgba(255, 255, 255, 0.4);
        }
        .btn-accessible:active {
            transform: scale(0.95);
        }

        /* Animação Pop In para Modais e Mensagens */
        @keyframes popIn {
            0% { transform: scale(0.6) translateY(20px); opacity: 0; }
            70% { transform: scale(1.05) translateY(-5px); opacity: 1; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        .animate-pop {
            animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Animação para Frases Flutuantes de Parabéns */
        @keyframes floatUpFade {
            0% { transform: translateY(0) scale(0.8); opacity: 1; }
            100% { transform: translateY(-70px) scale(1.2); opacity: 0; }
        }

        .floating-praise {
            position: absolute;
            z-index: 15;
            font-size: 1.75rem;
            font-weight: 800;
            color: #fde047;
            text-shadow: 0 2px 8px rgba(0,0,0,0.8), 0 0 15px rgba(250, 204, 21, 0.6);
            pointer-events: none;
            animation: floatUpFade 0.9s ease-out forwards;
        }

        /* Moldura de Vídeo/Foto da Vitória */
        .camera-frame {
            border: 6px solid #f59e0b;
            box-shadow: 0 0 30px rgba(245, 158, 11, 0.5), inset 0 0 15px rgba(245, 158, 11, 0.3);
            border-radius: 1.5rem;
        }
    </style>
</head>
<body class="relative flex items-center justify-center min-h-screen text-white overflow-hidden">

    <!-- Canvas de Fundo (Céu Azul, Nuvens, Estrelas, Aviões, Helicópteros) -->
    <canvas id="skyCanvas"></canvas>

    <!-- Canvas de Jogo (Balões Realistas e Confetes) -->
    <canvas id="gameCanvas"></canvas>

    <!-- Contêiner para mensagens flutuantes de parabéns -->
    <div id="praiseContainer" class="absolute inset-0 pointer-events-none z-30 overflow-hidden"></div>

    <!-- Interface do Usuário (Menus, HUD e Modais) -->
    <div id="uiLayer" class="flex flex-col justify-between p-4 md:p-6 w-full h-full">

        <!-- ================= 1. MENU PRINCIPAL ================= -->
        <div id="mainMenu" class="interactive my-auto max-w-xl mx-auto w-full bg-slate-900/90 backdrop-blur-md p-6 md:p-8 rounded-3xl border-4 border-blue-500/50 text-center shadow-2xl">
            <!-- Emblema / Header SENAI ADS -->
            <div class="mb-6">
                <span class="inline-block px-4 py-1.5 rounded-full bg-blue-600/30 border border-blue-400/50 text-blue-300 text-sm font-bold tracking-wider uppercase mb-3">
                    <i class="fa-solid fa-graduation-cap mr-1"></i> SENAI ADS
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-yellow-300 to-cyan-300">
                    Balões SENAI ADS
                </h1>
                <p class="text-base md:text-lg text-slate-300 mt-2 font-medium">
                    Análise e Desenvolvimento de Sistemas - Inclusivo & Divertido
                </p>
            </div>

            <!-- Botões Principais -->
            <div class="space-y-4">
                <button onclick="openDifficultyMenu('free')" 
                        class="btn-accessible w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-xl md:text-2xl font-bold flex items-center justify-center gap-3 border-b-4 border-teal-800">
                    <i class="fa-solid fa-gamepad text-2xl"></i>
                    <span>Modo Livre</span>
                </button>

                <button onclick="openDifficultyMenu('color')" 
                        class="btn-accessible w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-xl md:text-2xl font-bold flex items-center justify-center gap-3 border-b-4 border-purple-900">
