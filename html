                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-amber-300">SENAI ADS</h2>
                    <p class="text-sm text-slate-300">Análise e Desenvolvimento de Sistemas</p>
